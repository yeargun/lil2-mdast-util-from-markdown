{
  "name": "@itslil/lil2-mdast-util-from-markdown",
  "version": "0.1.0",
  "description": "mdast-util-from-markdown, rewritten in typed LilScript: a flat mdast arena, same trees",
  "type": "module",
  "license": "MIT",
  "author": "yeargun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/lil2-mdast-util-from-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/yeargun/lil2-mdast-util-from-markdown/issues"
  },
  "homepage": "https://yeargun.github.io/lil2-mdast-util-from-markdown/",
  "keywords": [
    "mdast",
    "mdast-util",
    "markdown",
    "ast",
    "parse",
    "lilscript",
    "lil2",
    "typed",
    "fast"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/from-markdown.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "convex": "./dist/from-markdown.js",
      "deno": "./dist/from-markdown.js",
      "edge-light": "./dist/from-markdown.js",
      "react-native": "./dist/from-markdown.js",
      "worker": "./dist/from-markdown.js",
      "workerd": "./dist/from-markdown.js",
      "browser": "./dist/browser/from-markdown.js",
      "default": "./dist/from-markdown.js"
    },
    "./constants": {
      "types": "./types/constants.d.ts",
      "convex": "./dist/constants.js",
      "deno": "./dist/constants.js",
      "edge-light": "./dist/constants.js",
      "react-native": "./dist/constants.js",
      "worker": "./dist/constants.js",
      "workerd": "./dist/constants.js",
      "browser": "./dist/browser/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "types",
    "NOTICE.md"
  ],
  "scripts": {
    "check:sources": "node scripts/shared-sources.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "node --test test/differential.test.mjs test/browser.test.mjs"
  },
  "devDependencies": {
    "character-entities": "2.0.2",
    "commonmark.json": "^0.31.0",
    "mdast-util-from-markdown": "2.0.3",
    "playwright-core": "^1.62.0"
  }
}
