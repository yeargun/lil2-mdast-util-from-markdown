// lil2-mdast-util-from-markdown: markdown to an mdast arena.

import { fromMarkdownTree } from "./mdast/parse.lil";
import { Tree } from "./mdast/tree.lil";

// The tree as positional columns (the arena's own arrays, not copies), indexed by node id; node 0 is the
// root. Every enumeration is an int: `kind` is a `K_*`, `identifier` an id into `identifiers` (-1: none),
// and a table's `num` is the offset of its alignments in `aux` (a count, then one `ALIGN_*` per column).
// `-1` is "none" in the link columns; offsets resolve to line and column through `lineStarts`.
//   [0] kind        [1] flags       [2] parent      [3] firstChild  [4] nextSibling
//   [5] startOffset [6] endOffset   [7] num         [8] s1          [9] s2
//   [10] s3         [11] identifier [12] label      [13] lineStarts [14] identifiers
//   [15] aux
export JsValue fromMarkdown(string value) {
  Tree t = fromMarkdownTree(value);
  return [t.kind, t.flags, t.parent, t.firstChild, t.nextSibling, t.sOffset, t.eOffset, t.num, t.s1, t.s2, t.s3, t.identifier, t.label, t.lineStarts, t.identifiers, t.aux];
}
